---
const { title, description = 'Oberoende guider om sparande, elavtal och lån.', frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const pageDesc = frontmatter?.description ?? description;
const isGuide = Boolean(frontmatter);
const SITE_NAME = 'Plånboksguiden';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle ? `${pageTitle} | ${SITE_NAME}` : SITE_NAME}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <style is:global>
      :root { --bg:#fbfaf7; --fg:#1d2321; --muted:#5b6662; --accent:#1f6f50; --line:#e3e0d8; --note:#f1efe8; }
      @media (prefers-color-scheme: dark) { :root { --bg:#141816; --fg:#e8ece9; --muted:#9aa6a1; --accent:#5fc49a; --line:#2a312e; --note:#1d2320; } }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--fg); font:17px/1.65 system-ui, -apple-system, "Segoe UI", sans-serif; }
      header, main, footer { max-width: 760px; margin: 0 auto; padding: 0 16px; }
      header { display:flex; justify-content:space-between; align-items:center; padding-top:20px; padding-bottom:20px; border-bottom:1px solid var(--line); }
      header a.brand { font-weight:700; font-size:1.15rem; color:var(--fg); text-decoration:none; }
      nav a { margin-left:16px; color:var(--muted); text-decoration:none; font-size:.95rem; }
      a { color: var(--accent); }
      h1 { line-height:1.2; font-size:2rem; margin-top:32px; }
      h2 { margin-top:2em; }
      .disclosure { background:var(--note); border-left:3px solid var(--accent); padding:10px 14px; font-size:.9rem; color:var(--muted); margin:16px 0; }
      table { border-collapse: collapse; width:100%; font-size:.95rem; }
      th, td { border-bottom:1px solid var(--line); padding:8px; text-align:left; }
      footer { margin-top:64px; padding-top:20px; padding-bottom:40px; border-top:1px solid var(--line); color:var(--muted); font-size:.85rem; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href={base}>{SITE_NAME}</a>
      <nav><a href={`${base}guider/`}>Guider</a><a href={`${base}om-oss/`}>Om oss</a></nav>
    </header>
    <main>
      {isGuide && <h1>{pageTitle}</h1>}
      {isGuide && <p class="disclosure">Annonslänkar: vissa länkar på sidan är affiliatelänkar. Om du blir kund kan vi få ersättning, utan extra kostnad för dig. Det påverkar inte våra bedömningar. <a href={`${base}om-oss/#ersattning`}>Så tjänar vi pengar</a>.</p>}
      <slot />
    </main>
    <footer>
      <p>{SITE_NAME} ger allmän information, inte personlig finansiell rådgivning. Kontrollera alltid aktuella villkor hos respektive bolag.</p>
      <p><a href={`${base}om-oss/`}>Om oss</a> · <a href={`${base}integritet/`}>Integritet och cookies</a></p>
    </footer>
  </body>
</html>
